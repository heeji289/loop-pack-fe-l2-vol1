# 서버 컴포넌트가 내부 API를 조회할 때 쓸 origin. 이 파일은 로컬 개발용 템플릿이고
# Preview·Production 값은 Vercel 환경 변수로 관리한다.
# build 전에 scripts/week-10-ci/validate-env.mjs가 검증한다 — 누락·비URL·http/https 외면 build 실패.
# (env 게이트 빨간불 실험 — http/https 외 프로토콜) 원복 예정
APP_ORIGIN=ftp://localhost:3000

# (env 게이트 빨간불 실험 — 서버 비밀 변수의 공개 접두 변형, 빈 값도 거부) 원복 예정
NEXT_PUBLIC_AUTH_SESSION_SECRET=

# 서버 세션 서명 비밀값. 로컬은 데모 기본값으로 충분하다.
# 배포 환경(Preview·Production)에서는 데모 기본값이 거부된다 — Vercel에 환경별 실제 값을 설정한다.
AUTH_SESSION_SECRET=loopers-week09-secret
